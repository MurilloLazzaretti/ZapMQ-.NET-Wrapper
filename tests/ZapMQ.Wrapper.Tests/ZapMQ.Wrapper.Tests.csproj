<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The tests run the wrapper against a real server, built from the ZapMQ repository.
         By default it is expected next to this one; point somewhere else with
         -p:ZapMQServerProject=<path to ZapMQ.Server.csproj>. -->
    <ZapMQServerProject Condition="'$(ZapMQServerProject)' == ''">..\..\..\ZapMQ\src\ZapMQ.Server\ZapMQ.Server.csproj</ZapMQServerProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZapMQ.netstandard.csproj" />
    <ProjectReference Include="$(ZapMQServerProject)" />
  </ItemGroup>

</Project>
